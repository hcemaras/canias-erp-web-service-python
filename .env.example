# Copy to .env and fill in. .env is git-ignored; never commit passwords.

# Service URL. It opens in a browser with ?wsdl appended. The path depends on the installation, e.g.
#   http://<tomcat>:<port>/CaniasWS-v2/services/CaniasWebService
#   http://<tomcat>:<port>/CaniasWebService/services/CaniasWebService
CANIAS_WS_URL=http://10.0.0.10:8080/CaniasWS-v2/services/CaniasWebService
CANIAS_WS_CLIENT=00
CANIAS_WS_LANGUAGE=T
# Aliases exactly as on the CANIAS login screen.
CANIAS_WS_DB_SERVER=
CANIAS_WS_DB_NAME=
CANIAS_WS_APP_SERVER=
CANIAS_WS_USER=
CANIAS_WS_PASSWORD=
# plain | md5  (try md5 if login returns error 2)
CANIAS_WS_PASSWORD_MODE=plain
CANIAS_WS_TIMEOUT=30
